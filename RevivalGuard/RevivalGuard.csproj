<Project Sdk="Microsoft.NET.Sdk">
  <!-- ACE server mod: anti-cheat guards for the Asherons Call Revived shard (docs/security/ANTI-CHEAT.md).
       Built ON the GPU box against the running server's own assemblies (tools/gpubox-ace/build-mods.sh);
       ACEBIN points at ~/ace/src/Source/ACE.Server/bin/Release/net10.0. Never copied next to the mod:
       the host already has them loaded. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>RevivalGuard</AssemblyName>
    <ACEBIN Condition="'$(ACEBIN)' == ''">$(HOME)/ace/src/Source/ACE.Server/bin/Release/net10.0</ACEBIN>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ACE.Server"><HintPath>$(ACEBIN)/ACE.Server.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ACE.Entity"><HintPath>$(ACEBIN)/ACE.Entity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ACE.Common"><HintPath>$(ACEBIN)/ACE.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ACE.DatLoader"><HintPath>$(ACEBIN)/ACE.DatLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ACE.Database"><HintPath>$(ACEBIN)/ACE.Database.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore"><HintPath>$(ACEBIN)/Microsoft.EntityFrameworkCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ACEBIN)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="log4net"><HintPath>$(ACEBIN)/log4net.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The feature request board's starting list (FeatureBoard), used once on a shard with no board file. -->
    <EmbeddedResource Include="FeatureRequestsSeed.json" LogicalName="RevivalGuard.FeatureRequestsSeed.json" />
    <!-- Real retail outfits from the packet captures, for the Dressing Room's Inspire (tools/dressing-room/outfits_extract.py). -->
    <EmbeddedResource Include="RetailOutfits.json" LogicalName="RevivalGuard.RetailOutfits.json" />
    <!-- The Holtburg Notice Board's starting words (NoticeBoard), written beside the dll on first read and edited there. -->
    <EmbeddedResource Include="NoticeBoard.json" LogicalName="RevivalGuard.NoticeBoard.json" />
    <!-- Holtburg town life: roster, rounds, lines (TownLife), seeded beside the dll; that copy is the live one, replaced by a newer embedded one unless hand-edited (SeedFileRule). -->
    <EmbeddedResource Include="TownLife.json" LogicalName="RevivalGuard.TownLife.json" />
    <!-- Holtburg raids: schedule, sides, raiders per tier, lines (TownRaid), seeded beside the dll the same way. -->
    <EmbeddedResource Include="TownRaid.json" LogicalName="RevivalGuard.TownRaid.json" />
    <!-- /deaths place names (DeathLog): towns from tools/web/towns.json, dungeon landblocks from dungeon-names.json. -->
    <EmbeddedResource Include="DeathPlaces.json" LogicalName="RevivalGuard.DeathPlaces.json" />
    <!-- Corpse capsules: real 2017 player corpses, retail looks, proven-floor sites, item pools, invented names (tools/corpse-capsules/gen.py). -->
    <EmbeddedResource Include="CorpseCapsules.json" LogicalName="RevivalGuard.CorpseCapsules.json" />
    <!-- On this day: dated real AC history for the world line (OnThisDay), paraphrased from the AC wiki (CC-BY-SA), source_url per entry. -->
    <EmbeddedResource Include="OnThisDay.json" LogicalName="RevivalGuard.OnThisDay.json" />
    <!-- Boss kill news (BossBroadcast): wiki "Boss Creatures" + ours (tools/bossbroadcast/build_list.py). -->
    <EmbeddedResource Include="BossBroadcast.json" LogicalName="RevivalGuard.BossBroadcast.json" />
    <!-- Our ClothingTables (CustomClothing; tools/gpubox-ace/gen_rune_suits.py), seeded into clothing/ beside the dll. -->
    <EmbeddedResource Include="clothing/*.json" LogicalName="RevivalGuard.clothing.%(Filename)%(Extension)" />
    <!-- The look showcase's effects (LookShowcase; tools/gpubox-ace/gen_look_showcase.py), read from the dll. -->
    <EmbeddedResource Include="LookShowcase.json" LogicalName="RevivalGuard.LookShowcase.json" />
    <!-- The Look Lab's packaged items' effects (LookShowcase, rg_look_lab; tools/looklab/package.py). -->
    <EmbeddedResource Include="LookLab.json" LogicalName="RevivalGuard.LookLab.json" />
  </ItemGroup>
</Project>
