  "lines": {
    "warn.drudge.south": ["Drudges on the south road, up from the Hideout! To arms!", "Drudges coming up the south road! Clear the square!"],
    "warn.drudge.west": ["Drudges out of the western woods! To arms, Holtburg!", "Drudges in the west fields! Look sharp!"],
    "warn.mosswart.north": ["Mosswarts up from the lake shore! Guard the lower lanes!", "Mosswarts on the north bank! To arms!"],
    "warn.bandit.east": ["Bandits on the east road! Bar your doors and take up your swords!", "Riders on the east road, and not friendly ones! To arms!"],
    "area.warn": ["Raid on Holtburg! {Group} are coming from {side}. They reach the town in about a minute."],
    "warn.theme": ["{Group} on {side}! To arms, Holtburg!", "{Group} coming up {side}! Clear the square!"],
    "area.theme": ["This is no ordinary raid. {Theme} have come for Holtburg."],
    "theme.fowlplay": ["Farmer Ar'Oyd's feast has stirred up every bird for miles, and they are in a fury.", "Feathers everywhere! The birds of the county have had enough of the harvest table."],
    "theme.festivalseason": ["The harvest moon has stirred the graves.", "Something has woken the dead, and they want the living."],
    "theme.frostfell": ["The cold has come down on Holtburg, and it has brought its own.", "Snowmen? Penguins? The winter has sent its own against the town!"],
    "theme.spring": ["The creatures of the fields are frightened and snapping. Mind your step.", "Spring has the wild things running wild."],
    "theme.meetinghalls": ["The Viamontian strike forces have come out of the Meeting Halls."],
    "theme.carlo": ["Whatever Carlo fled is following him."],
    "theme.burunraids": ["The Burun have come up out of the swamps."],
    "theme.virindiayan": ["Virindi drift in, watching. They are not here to talk."],
    "theme.martineattacks": ["Renegade Virindi hunt the town. Martine's hand is in this."],
    "theme.heroraids": ["There will be Hero Tokens in this fight."],
    "theme.viridianbaishi": ["They swarm out of the thorns of the Viridian Rise!"],
    "theme.mhoire": ["The dead of House Mhoire walk far from their graves."],
    "theme.burnja": ["Captain Burnja's drudges, torches lit!"],
    "theme.burritual": ["The Bur portal has drawn the Falatacot out."],
    "theme.tthuunritual": ["The ritual of T'thuun has drawn the Falatacot out."],
    "theme.prodigal": ["Aerbax's twisted children have found the town."],
    "theme.gauntlet": ["Shadows slip in from every side!"],
    "theme.dranith": ["Martine's hollow creations shamble in."],
    "theme.greatwork": ["The Gelidite dead of Frore come, and the air goes cold."],
    "theme.tthuun": ["T'thuun's Marauders, up from the deep places!"],
    "theme.shardherald": ["Anadil's dead walk out of the shadow of Ithaenc!"],
    "theme.lightbringer": ["The Hopeslayer's shadow is long."],
    "area.big": ["This is a war band, not a raiding party. Something bigger walks behind them."],
    "area.arrive": ["The {group} reach the edge of Holtburg!"],
    "leader": ["{leader} comes in with the last of them!", "{leader} leads the last wave in!"],
    "guard.wave": ["More of them on {side}! Hold your ground!", "Another lot coming up {side}! Stand fast!", "They are not done yet! Here come more!"],
    "guard.lastwave": ["This is the last of them! Hold, and Holtburg is safe!", "Here comes the last of them! Do not give ground now!"],
    "area.wave": ["More {group} come from {side}!"],
    "guard.reinforce": ["Too many of them! Reinforcements! To me!", "We need more swords here! Sound the call!"],
    "guard.reserve": ["The reserve is here. Hold the line!", "Fall in! We hold the town!"],
    "guard.held": ["They break! Holtburg holds!", "That is the last of them. Well fought, all of you."],
    "area.held": ["Holtburg holds! The raiders are beaten off. Those who fought have earned the town's thanks."],
