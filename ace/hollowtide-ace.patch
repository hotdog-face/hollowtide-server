+using System;
+using System.Globalization;
+using System.IO;
+using System.Net;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+
+using ACE.Database;
+using ACE.Entity;
+using ACE.Entity.Enum;
+using ACE.Entity.Enum.Properties;
+using ACE.Entity.Models;
+using ACE.Server.Entity.Actions;
+using ACE.Server.Managers;
+using ACE.Server.Network;
+using ACE.Server.Network.Enum;
+using ACE.Server.Network.GameMessages.Messages;
+using ACE.Server.Network.Managers;
+using ACE.Server.WorldObjects;
+
+namespace ACE.Server.Managers
+{
+    /// <summary>
+    /// ADDITIVE ACE MOD — preserve across upstream bumps (like the DxtUtil mod).
+    ///
+    /// A tiny HTTP endpoint for external monitoring/admin tooling (tools/server-monitor).
+    ///
+    /// GET /status  — READ-ONLY, UNAUTHENTICATED. Exposes the live in-memory online-player set
+    ///   (PlayerManager, under its own read lock) as JSON so a dashboard can show who is online RIGHT
+    ///   NOW — which the shard DB cannot (it only holds persisted state). Never mutates game state.
+    ///
+    /// POST /admin/*  — AUTHENTICATED (Bearer token). ADMIN ACTIONS v3. Each action routes through
+    ///   ACE's OWN command/PlayerManager APIs (never a raw DB/auth write — matches the read-only,
+    ///   validated posture) and is MARSHALLED onto ACE's world thread via WorldManager.EnqueueAction
+    ///   (HttpListener runs on a foreign thread; ACE world state is NOT free-threaded). The HTTP call
+    ///   returns 202 Accepted immediately; the action applies on the next world tick.
+    ///
+    /// Auth: on Start(), a 32-hex-char bearer token is read from (or generated into)
+    ///   ace-runtime/monitor-token.txt (chmod 600). Every POST must carry
+    ///   "Authorization: Bearer &lt;token&gt;"; missing/wrong → 401, no action. Bind stays loopback only.
+    /// </summary>
+    public static class MonitorServer
+    {
+        private static HttpListener _listener;
+        private static string _token;
+        private static readonly int Port =
+            int.TryParse(Environment.GetEnvironmentVariable("ACE_MONITOR_PORT"), out var p) ? p : 8771;
+
+        public static void Start()
+        {
+            if (_listener != null) return;
+            try
+            {
+                _token = LoadOrCreateToken();
+
+                _listener = new HttpListener();
+                _listener.Prefixes.Add($"http://127.0.0.1:{Port}/");
+                _listener.Start();
+                var t = new Thread(Loop) { IsBackground = true, Name = "MonitorServer" };
+                t.Start();
+                Console.WriteLine($"[monitor] status endpoint on http://127.0.0.1:{Port}/status");
+                Console.WriteLine($"[monitor] admin POST endpoints enabled (Bearer token, loopback only): /admin/broadcast /admin/boot /admin/tele /admin/summon");
+            }
+            catch (Exception ex)
+            {
+                Console.WriteLine("[monitor] failed to start (non-fatal): " + ex.Message);
+                _listener = null;
+            }
+        }
+
+        /// <summary>
+        /// Read the admin bearer token from ace-runtime/monitor-token.txt, generating a 32-hex-char one
+        /// (chmod 600) if absent. The runtime dir is resolved relative to the ACE working directory
+        /// (the process runs from bin/Release/... so we walk up to the repo's server/ace-runtime).
+        /// </summary>
+        private static string LoadOrCreateToken()
+        {
+            var path = ResolveTokenPath();
+            try
+            {
+                if (File.Exists(path))
+                {
+                    var existing = File.ReadAllText(path).Trim();
+                    if (existing.Length >= 16)
+                    {
+                        Console.WriteLine($"[monitor] admin token loaded from {path}");
+                        return existing;
+                    }
+                }
+
+                var bytes = new byte[16];
+                using (var rng = RandomNumberGenerator.Create()) rng.GetBytes(bytes);
+                var tok = BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant(); // 32 hex chars
+
+                Directory.CreateDirectory(Path.GetDirectoryName(path));
+                File.WriteAllText(path, tok + "\n");
+                ChmodSixHundred(path);
+                Console.WriteLine($"[monitor] generated new admin token → {path} (chmod 600)");
+                return tok;
+            }
+            catch (Exception ex)
+            {
+                // Fall back to an in-memory ephemeral token so POST is not silently open on a file error.
+                Console.WriteLine("[monitor] token file error (using ephemeral in-memory token): " + ex.Message);
+                var bytes = new byte[16];
+                using (var rng = RandomNumberGenerator.Create()) rng.GetBytes(bytes);
+                return BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant();
+            }
+        }
+
+        private static string ResolveTokenPath()
+        {
+            // Allow explicit override for tests / relocated runtimes.
+            var overridePath = Environment.GetEnvironmentVariable("ACE_MONITOR_TOKEN_FILE");
+            if (!string.IsNullOrEmpty(overridePath)) return overridePath;
+
+            // ACE runs from server/_ace_upstream/Source/ACE.Server/bin/Release/net10.0/. Walk up to the
+            // repo's server/ dir and land on server/ace-runtime/monitor-token.txt. If we can't find it,
+            // fall back to a token beside the executable.
+            var dir = new DirectoryInfo(AppContext.BaseDirectory);
+            for (int i = 0; i < 12 && dir != null; i++, dir = dir.Parent)
+            {
+                var candidate = Path.Combine(dir.FullName, "ace-runtime");
+                if (Directory.Exists(candidate))
+                    return Path.Combine(candidate, "monitor-token.txt");
+            }
+            return Path.Combine(AppContext.BaseDirectory, "monitor-token.txt");
+        }
+
+        private static void ChmodSixHundred(string path)
+        {
+            try
+            {
+                var psi = new System.Diagnostics.ProcessStartInfo("chmod", $"600 \"{path}\"")
+                { UseShellExecute = false, CreateNoWindow = true };
+                System.Diagnostics.Process.Start(psi)?.WaitForExit(2000);
+            }
+            catch { /* best effort; Windows / no chmod is fine */ }
+        }
+
+        private static void Loop()
+        {
+            while (_listener != null && _listener.IsListening)
+            {
+                HttpListenerContext ctx;
+                try { ctx = _listener.GetContext(); }
+                catch { break; }
+                try { Handle(ctx); }
+                catch (Exception ex)
+                {
+                    Console.WriteLine("[monitor] request error (non-fatal): " + ex.Message);
+                    try { ctx.Response.StatusCode = 500; ctx.Response.Close(); } catch { }
+                }
+            }
+        }
+
+        private static void Handle(HttpListenerContext ctx)
+        {
+            var path = ctx.Request.Url.AbsolutePath;
+            var method = ctx.Request.HttpMethod;
+
+            // --- READ-ONLY, unauthenticated -------------------------------------------------------
+            if (method == "GET" && path == "/status") { Write(ctx, 200, BuildStatus()); return; }
+
+            // --- ADMIN ACTIONS (POST, Bearer-token) -----------------------------------------------
+            if (method == "POST" && path.StartsWith("/admin/"))
+            {
+                if (!RequireToken(ctx)) { Write(ctx, 401, "{\"ok\":false,\"error\":\"unauthorized\"}"); return; }
+
+                string body = ReadBody(ctx);
+                try
+                {
+                    switch (path)
+                    {
+                        case "/admin/broadcast": Write(ctx, 202, DoBroadcast(body)); return;
+                        case "/admin/boot":      Write(ctx, 202, DoBoot(body));      return;
+                        case "/admin/tele":      Write(ctx, 202, DoTele(body));      return;
+                        case "/admin/summon":    Write(ctx, 202, DoSummon(body));    return;
+                        default: Write(ctx, 404, "{\"ok\":false,\"error\":\"unknown admin endpoint\"}"); return;
+                    }
+                }
+                catch (Exception ex)
+                {
+                    Write(ctx, 400, "{\"ok\":false,\"error\":" + Js(ex.Message) + "}");
+                    return;
+                }
+            }
+
+            Write(ctx, 200,
+                "{\"ok\":true,\"endpoints\":{\"GET\":[\"/status\"],\"POST\":[\"/admin/broadcast\",\"/admin/boot\",\"/admin/tele\",\"/admin/summon\"]}}");
+        }
+
+        // ============================ ADMIN ACTIONS ==============================================
+        //
+        // Every action is enqueued onto ACE's world thread via WorldManager.EnqueueAction(...) and
+        // applied on the next tick (WorldManager.cs: EnqueueAction @308 → ActionQueue.RunActions @368).
+        // We NEVER touch world objects from this HttpListener thread. Target resolution + validation
+        // that only reads immutable/thread-safe state (PlayerManager online snapshot, POI DB cache)
+        // may run inline; the actual mutation always runs inside the enqueued delegate.
+
+        /// <summary>
+        /// /admin/broadcast {"text":"..."} → server-wide WorldBroadcast.
+        /// Mirrors @gamecast: PlayerManager.BroadcastToAll(new GameMessageSystemChat(msg, WorldBroadcast))
+        /// (AdminCommands.cs HandleGamecast:1104-1106).
+        /// </summary>
+        private static string DoBroadcast(string body)
+        {
+            var text = JsonStr(body, "text");
+            if (string.IsNullOrWhiteSpace(text))
+                return "{\"ok\":false,\"error\":\"missing 'text'\"}";
+
+            var msg = $"Broadcast from System> {text}";
+            WorldManager.EnqueueAction(new ActionEventDelegate(() =>
+            {
+                PlayerManager.BroadcastToAll(
+                    new GameMessageSystemChat(msg, ChatMessageType.WorldBroadcast));
+            }));
+
+            Console.WriteLine($"[monitor] ADMIN broadcast by token — {text}");
+            return "{\"ok\":true,\"queued\":\"broadcast\"}";
+        }
+
+        /// <summary>
+        /// /admin/boot {"guid":N} or {"account":"x"} or {"name":"x"} → boot that session.
+        /// Mirrors @boot: session.Terminate(SessionTerminationReason.AccountBooted,
+        /// new GameMessageBootAccount(...), null, reason) (SentinelCommands.cs HandleBoot:333).
+        /// </summary>
+        private static string DoBoot(string body)
+        {
+            var reason = JsonStr(body, "reason");
+            var account = JsonStr(body, "account");
+            var name = JsonStr(body, "name");
+            var guid = JsonUInt(body, "guid");
+
+            // Resolve target session. GetOnlinePlayer(...) reads the PlayerManager online snapshot
+            // (its own read lock); NetworkManager.Find(account) reads the session dict — both safe to
+            // read here. The Terminate call itself is enqueued to the world thread.
+            Session target = null;
+            string who;
+            if (guid.HasValue)
+            {
+                target = PlayerManager.GetOnlinePlayer(guid.Value)?.Session;
+                who = $"guid 0x{guid.Value:X8}";
+            }
+            else if (!string.IsNullOrEmpty(account))
+            {
+                target = NetworkManager.Find(account);
+                who = $"account {account}";
+            }
+            else if (!string.IsNullOrEmpty(name))
+            {
+                target = PlayerManager.GetOnlinePlayer(name)?.Session;
+                who = $"char {name}";
+            }
+            else
+            {
+                return "{\"ok\":false,\"error\":\"specify 'guid', 'account', or 'name'\"}";
+            }
+
+            if (target == null)
+                return "{\"ok\":false,\"error\":\"target not online / not found\"}";
+
+            var captured = target;
+            var extra = string.IsNullOrEmpty(reason) ? null : reason;
+            WorldManager.EnqueueAction(new ActionEventDelegate(() =>
+            {
+                captured.Terminate(
+                    SessionTerminationReason.AccountBooted,
+                    new GameMessageBootAccount(extra != null ? $" - {extra}" : null),
+                    null,
+                    extra);
+            }));
+
+            Console.WriteLine($"[monitor] ADMIN boot by token — {who}" + (extra != null ? $" reason: {extra}" : ""));
+            return "{\"ok\":true,\"queued\":\"boot\"}";
+        }
+
+        /// <summary>
+        /// /admin/tele {"guid":N,"dest":"Arwic"} → teleport a player to a named POI, OR
+        /// {"guid":N,"cell":123,"x":..,"y":..,"z":..} → teleport to an explicit cell+xyz.
+        /// POI path mirrors @telepoi (AdminCommands.cs HandleTeleportPoi:898-907):
+        ///   DatabaseManager.World.GetCachedPointOfInterest → weenie.GetPosition(Destination)
+        ///   → WorldObject.AdjustDungeon → player.Teleport(pos).
+        /// Explicit path mirrors @teleloc (Player.Teleport(new Position(cell,x,y,z,...))).
+        /// </summary>
+        private static string DoTele(string body)
+        {
+            var guid = JsonUInt(body, "guid");
+            if (!guid.HasValue) return "{\"ok\":false,\"error\":\"missing 'guid'\"}";
+
+            var player = PlayerManager.GetOnlinePlayer(guid.Value);
+            if (player == null) return "{\"ok\":false,\"error\":\"target not online\"}";
+
+            var dest = JsonStr(body, "dest");
+            Position pos;
+            string detail;
+
+            if (!string.IsNullOrEmpty(dest))
+            {
+                // POI lookup — DB cache read; safe off-thread. Copied from @telepoi.
+                var poi = DatabaseManager.World.GetCachedPointOfInterest(dest);
+                if (poi == null)
+                    return "{\"ok\":false,\"error\":" + Js($"POI '{dest}' not found") + "}";
+                var weenie = DatabaseManager.World.GetCachedWeenie(poi.WeenieClassId);
+                if (weenie == null)
+                    return "{\"ok\":false,\"error\":\"POI weenie missing\"}";
+                pos = new Position(weenie.GetPosition(PositionType.Destination));
+                WorldObject.AdjustDungeon(pos);
+                detail = $"guid 0x{guid.Value:X8} → POI {dest}";
+            }
+            else
+            {
+                var cell = JsonUInt(body, "cell");
+                var x = JsonFloat(body, "x");
+                var y = JsonFloat(body, "y");
+                var z = JsonFloat(body, "z");
+                if (!cell.HasValue || !x.HasValue || !y.HasValue || !z.HasValue)
+                    return "{\"ok\":false,\"error\":\"provide 'dest' OR 'cell'+'x'+'y'+'z'\"}";
+                pos = new Position(cell.Value, x.Value, y.Value, z.Value, 0f, 0f, 0f, 1f);
+                detail = $"guid 0x{guid.Value:X8} → 0x{cell.Value:X8} {x.Value},{y.Value},{z.Value}";
+            }
+
+            var capturedPlayer = player;
+            var capturedPos = pos;
+            WorldManager.EnqueueAction(new ActionEventDelegate(() => capturedPlayer.Teleport(capturedPos)));
+
+            Console.WriteLine($"[monitor] ADMIN tele by token — {detail}");
+            return "{\"ok\":true,\"queued\":\"tele\"}";
+        }
+
+        /// <summary>
+        /// /admin/summon {"guid":N,"to":M} → teleport player N to player M's current location
+        /// (M defaults to nothing — 'to' is required since the mod has no admin avatar). Mirrors the
+        /// per-player leg of @teleallto: player.Teleport(new Position(destinationPlayer.Location))
+        /// (AdminCommands.cs HandleTeleAllTo:866-868).
+        /// </summary>
+        private static string DoSummon(string body)
+        {
+            var guid = JsonUInt(body, "guid");
+            var to = JsonUInt(body, "to");
+            if (!guid.HasValue) return "{\"ok\":false,\"error\":\"missing 'guid' (player to move)\"}";
+            if (!to.HasValue)   return "{\"ok\":false,\"error\":\"missing 'to' (destination player guid)\"}";
+
+            var player = PlayerManager.GetOnlinePlayer(guid.Value);
+            var destPlayer = PlayerManager.GetOnlinePlayer(to.Value);
+            if (player == null)     return "{\"ok\":false,\"error\":\"player to move not online\"}";
+            if (destPlayer == null) return "{\"ok\":false,\"error\":\"destination player not online\"}";
+
+            var capturedPlayer = player;
+            var capturedDest = destPlayer;
+            WorldManager.EnqueueAction(new ActionEventDelegate(() =>
+            {
+                // Save a return position (like @teleto/teleallto) then move.
+                capturedPlayer.SetPosition(PositionType.TeleportedCharacter, new Position(capturedPlayer.Location));
+                capturedPlayer.Teleport(new Position(capturedDest.Location));
+            }));
+
+            Console.WriteLine($"[monitor] ADMIN summon by token — 0x{guid.Value:X8} → 0x{to.Value:X8}");
+            return "{\"ok\":true,\"queued\":\"summon\"}";
+        }
+
+        // ============================ AUTH + HTTP PLUMBING ======================================
+
+        private static bool RequireToken(HttpListenerContext ctx)
+        {
+            var auth = ctx.Request.Headers["Authorization"];
+            if (string.IsNullOrEmpty(auth)) return false;
+            const string prefix = "Bearer ";
+            if (!auth.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) return false;
+            var supplied = auth.Substring(prefix.Length).Trim();
+            return ConstantTimeEquals(supplied, _token);
+        }
+
+        private static bool ConstantTimeEquals(string a, string b)
+        {
+            if (a == null || b == null || a.Length != b.Length) return false;
+            int diff = 0;
+            for (int i = 0; i < a.Length; i++) diff |= a[i] ^ b[i];
+            return diff == 0;
+        }
+
+        private static string ReadBody(HttpListenerContext ctx)
+        {
+            if (!ctx.Request.HasEntityBody) return "";
+            using var sr = new StreamReader(ctx.Request.InputStream, ctx.Request.ContentEncoding ?? Encoding.UTF8);
+            return sr.ReadToEnd();
+        }
+
+        private static void Write(HttpListenerContext ctx, int status, string body)
+        {
+            var bytes = Encoding.UTF8.GetBytes(body);
+            ctx.Response.StatusCode = status;
+            ctx.Response.ContentType = "application/json";
+            ctx.Response.Headers["Access-Control-Allow-Origin"] = "*";   // let the local dashboard fetch it
+            ctx.Response.ContentLength64 = bytes.Length;
+            ctx.Response.OutputStream.Write(bytes, 0, bytes.Length);
+            ctx.Response.Close();
+        }
+
+        private static string BuildStatus()
+        {
+            var online = PlayerManager.GetAllOnline();   // thread-safe snapshot (PlayerManager read lock)
+            var sb = new StringBuilder(256);
+            sb.Append("{\"online\":").Append(online.Count).Append(",\"players\":[");
+            bool first = true;
+            foreach (var pl in online)
+            {
+                try
+                {
+                    if (!first) sb.Append(',');
+                    first = false;
+                    var loc = pl.Location;
+                    sb.Append("{\"guid\":").Append(pl.Guid.Full)
+                      .Append(",\"name\":").Append(Js(pl.Name))
+                      .Append(",\"level\":").Append(pl.Level ?? 0)
+                      .Append(",\"cell\":").Append(loc != null ? loc.LandblockId.Raw : 0)
+                      .Append(",\"x\":").Append(F(loc?.PositionX ?? 0f))
+                      .Append(",\"y\":").Append(F(loc?.PositionY ?? 0f))
+                      .Append(",\"z\":").Append(F(loc?.PositionZ ?? 0f))
+                      .Append(",\"hp\":[").Append(pl.Health.Current).Append(',').Append(pl.Health.MaxValue).Append(']')
+                      .Append(",\"stam\":[").Append(pl.Stamina.Current).Append(',').Append(pl.Stamina.MaxValue).Append(']')
+                      .Append(",\"mana\":[").Append(pl.Mana.Current).Append(',').Append(pl.Mana.MaxValue).Append(']')
+                      .Append(",\"account\":").Append(Js(pl.Session?.Account ?? ""))
+                      .Append('}');
+                }
+                catch { /* skip a player mid-transition rather than fail the whole response */ }
+            }
+            sb.Append("]}");
+            return sb.ToString();
+        }
+
+        // ---- minimal, dependency-free JSON field extraction (no System.Text.Json contract needed) ----
+        // The admin bodies are tiny flat objects: {"text":"..","guid":123,"dest":".."}. We only need a
+        // few scalar fields, so a targeted scanner avoids pulling in a serializer and matches the mod's
+        // "no new dependencies" rule.
+
+        private static string JsonStr(string json, string key)
+        {
+            if (string.IsNullOrEmpty(json)) return null;
+            int i = FindKey(json, key);
+            if (i < 0) return null;
+            i = SkipToValue(json, i);
+            if (i < 0 || i >= json.Length || json[i] != '"') return null;
+            i++;
+            var sb = new StringBuilder();
+            while (i < json.Length && json[i] != '"')
+            {
+                if (json[i] == '\\' && i + 1 < json.Length)
+                {
+                    i++;
+                    switch (json[i])
+                    {
+                        case 'n': sb.Append('\n'); break;
+                        case 't': sb.Append('\t'); break;
+                        case 'r': sb.Append('\r'); break;
+                        case '"': sb.Append('"'); break;
+                        case '\\': sb.Append('\\'); break;
+                        case '/': sb.Append('/'); break;
+                        default: sb.Append(json[i]); break;
+                    }
+                }
+                else sb.Append(json[i]);
+                i++;
+            }
+            return sb.ToString();
+        }
+
+        private static uint? JsonUInt(string json, string key)
+        {
+            var raw = JsonNumberRaw(json, key);
+            if (raw == null) return null;
+            raw = raw.Trim();
+            if (raw.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                return uint.TryParse(raw.Substring(2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var h) ? h : (uint?)null;
+            // JSON numbers may be large decimals; parse as ulong then narrow.
+            return ulong.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? (uint)v : (uint?)null;
+        }
+
+        private static float? JsonFloat(string json, string key)
+        {
+            var raw = JsonNumberRaw(json, key);
+            if (raw == null) return null;
+            return float.TryParse(raw.Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : (float?)null;
+        }
+
+        private static string JsonNumberRaw(string json, string key)
+        {
+            if (string.IsNullOrEmpty(json)) return null;
+            int i = FindKey(json, key);
+            if (i < 0) return null;
+            i = SkipToValue(json, i);
+            if (i < 0 || i >= json.Length) return null;
+            // Support quoted numbers too (e.g. "guid":"0x51234567").
+            if (json[i] == '"') { i++; int q = json.IndexOf('"', i); return q < 0 ? null : json.Substring(i, q - i); }
+            int start = i;
+            while (i < json.Length && (char.IsLetterOrDigit(json[i]) || json[i] == '.' || json[i] == '-' || json[i] == '+'))
+                i++;
+            return i > start ? json.Substring(start, i - start) : null;
+        }
+
+        // Find `"key"` and return the index just past its closing quote, or -1.
+        private static int FindKey(string json, string key)
+        {
+            var needle = "\"" + key + "\"";
+            int idx = json.IndexOf(needle, StringComparison.Ordinal);
+            return idx < 0 ? -1 : idx + needle.Length;
+        }
+
+        // From just past a key, skip whitespace + the ':' to the first char of the value.
+        private static int SkipToValue(string json, int i)
+        {
+            while (i < json.Length && (json[i] == ' ' || json[i] == '\t' || json[i] == '\r' || json[i] == '\n')) i++;
+            if (i >= json.Length || json[i] != ':') return -1;
+            i++;
+            while (i < json.Length && (json[i] == ' ' || json[i] == '\t' || json[i] == '\r' || json[i] == '\n')) i++;
+            return i;
+        }
+
+        private static string F(float v) => v.ToString("0.###", CultureInfo.InvariantCulture);
+
+        private static string Js(string s)
+        {
+            if (string.IsNullOrEmpty(s)) return "\"\"";
+            var sb = new StringBuilder(s.Length + 2);
+            sb.Append('"');
+            foreach (char c in s)
+            {
+                if (c == '"' || c == '\\') sb.Append('\\').Append(c);
+                else if (c >= 0x20) sb.Append(c);
+            }
+            return sb.Append('"').ToString();
+        }
+    }
+}
