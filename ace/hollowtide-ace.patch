+        /// <summary>
+        /// (custom, for rescue_invalid_locations) Structural sanity check for a saved character
+        /// position, used ONLY at player enter-world. Reuses the same dat machinery the
+        /// AdjustDungeon family is built on rather than reinventing geometry math:
+        /// - indoor cell id => the landblock's LandblockInfo must exist and actually contain that
+        ///   env cell, and the coordinates must lie inside SOME env cell of the landblock
+        ///   (AdjustCell.GetCell — catches the classic corruption of an indoor cell id saved with
+        ///   outdoor coordinates by a teleport interrupted mid-save)
+        /// - outdoor cell id => the terrain cell must be derivable (0x01-0x40), the coordinates
+        ///   within landblock bounds, and the landblock loadable from the cell dat
+        /// </summary>
+        private static bool IsSaneEnterPosition(Position pos, out string reason)
+        {
+            reason = null;
+
+            if (pos == null)
+            {
+                reason = "null position";
+                return false;
+            }
+
+            if (float.IsNaN(pos.PositionX) || float.IsNaN(pos.PositionY) || float.IsNaN(pos.PositionZ) ||
+                float.IsInfinity(pos.PositionX) || float.IsInfinity(pos.PositionY) || float.IsInfinity(pos.PositionZ))
+            {
+                reason = $"non-finite coordinates ({pos.PositionX}, {pos.PositionY}, {pos.PositionZ})";
+                return false;
+            }
+
+            var cellId = pos.Cell & 0xFFFF;
+
+            if (pos.Indoors)
+            {
+                // the landblock's LandblockInfo must exist and actually contain this env cell
+                // (same dat read AdjustCell's constructor uses; env cells are 0x100..0x100+NumCells-1)
+                var blockInfo = ACE.DatLoader.DatManager.CellDat.ReadFromDat<ACE.DatLoader.FileTypes.LandblockInfo>(pos.Landblock << 16 | 0xFFFE);
+                var numCells = blockInfo?.NumCells ?? 0;
+
+                if (cellId - 0x100 >= numCells)
+                {
+                    reason = $"indoor cell 0x{pos.Cell:X8} does not exist (landblock has {numCells} env cells)";
+                    return false;
+                }
+
+                // the known corruption signature: a real indoor cell id saved with coordinates that
+                // are not inside ANY env cell of that landblock. Reuse the env-cell walk that
+                // WorldObject.AdjustDungeonCells already uses for every dungeon teleport.
+                var adjustCell = ACE.Server.Physics.Util.AdjustCell.Get(pos.Landblock);
+                if (adjustCell == null || adjustCell.GetCell(pos.Pos) == null)
+                {
+                    reason = $"indoor cell 0x{pos.Cell:X8} but coords [{pos.PositionX:F3} {pos.PositionY:F3} {pos.PositionZ:F3}] are outside every env cell of the landblock";
+                    return false;
+                }
+            }
+            else
+            {
+                // outdoor: cell id must be a derivable terrain cell (1..64)
+                if (cellId == 0 || cellId > 64)
+                {
+                    reason = $"outdoor position with underivable cell id 0x{pos.Cell:X8}";
+                    return false;
+                }
+
+                if (pos.PositionX < 0 || pos.PositionX > Position.BlockLength ||
+                    pos.PositionY < 0 || pos.PositionY > Position.BlockLength)
+                {
+                    reason = $"outdoor coords [{pos.PositionX:F3} {pos.PositionY:F3}] outside landblock bounds (0-{Position.BlockLength})";
+                    return false;
+                }
+
+                // the landblock itself must be loadable from the cell dat
+                var cellLandblock = ACE.DatLoader.DatManager.CellDat.ReadFromDat<ACE.DatLoader.FileTypes.CellLandblock>(pos.Landblock << 16 | 0xFFFF);
+                if (cellLandblock == null)
+                {
+                    reason = $"landblock 0x{pos.Landblock:X4} not found in cell dat";
+                    return false;
+                }
+            }
