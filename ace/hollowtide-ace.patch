diff --git a/Source/ACE.Server/Managers/WorldManager.cs b/Source/ACE.Server/Managers/WorldManager.cs
index 53cd3ab9..52037ed2 100644
--- a/Source/ACE.Server/Managers/WorldManager.cs
+++ b/Source/ACE.Server/Managers/WorldManager.cs
@@ -217,6 +217,41 @@ private static void DoPlayerEnterWorld(Session session, Character character, Bio
             if (olthoiPlayerReturnedToLifestone)
                 session.Player.Location = new Position(session.Player.Sanctuary);
 
+            // rescue_invalid_locations (custom): a character saved with a structurally corrupt
+            // Location (e.g. a teleport interrupted mid-save leaving an indoor cell id with outdoor
+            // coordinates, or Location/LastPortal on mismatched landblocks) login-loops forever —
+            // the enter starts, the world load hangs or the client is kicked, repeat — and the only
+            // historical fix was manual DB surgery (set Location := bind stone). When enabled,
+            // validate the saved position here, before it is ever used to place the player, and
+            // self-rescue to the lifestone (then heritage starter town, then Holtburg). PLAYER
+            // enter-world only; mid-session teleport/portal paths are untouched. The enter is
+            // never rejected.
+            if (PropertyManager.GetBool("rescue_invalid_locations").Item)
+            {
+                if (!IsSaneEnterPosition(session.Player.Location, out var invalidReason))
+                {
+                    var rescue = GetEnterRescuePosition(session.Player, out var rescueSource);
+
+                    log.Warn($"enter rescue: {session.Player.Name} saved location invalid ({invalidReason}) -> {rescueSource}");
+
+                    session.Player.Location = rescue;
+                }
+
