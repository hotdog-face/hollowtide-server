diff --git a/Source/ACE.DatLoader/FileTypes/SetupModel.cs b/Source/ACE.DatLoader/FileTypes/SetupModel.cs
index b53bae90..3a0069c2 100644
--- a/Source/ACE.DatLoader/FileTypes/SetupModel.cs
+++ b/Source/ACE.DatLoader/FileTypes/SetupModel.cs
@@ -115,5 +115,38 @@ public static SetupModel CreateSimpleSetup()
 
             return setup;
         }
+
+        /// <summary>
+        /// Synthesizes a single-part SetupModel that wraps a raw 0x01 GfxObj, so that consumers
+        /// which expect a 0x02 SetupModel can be handed a mesh id without parsing it as a setup.
+        /// <para />
+        /// This mirrors what the physics layer already does for the same id in
+        /// ACE.Server.Physics.Setup.MakeSimpleSetup: one part, holding the mesh itself. The
+        /// PhysicsPolygons / PhysicsBSP ride on the GfxObj rather than the setup, so collision is
+        /// unaffected by the wrapping -- HasPhysicsBSP is simply carried across from the mesh flags.
+        /// <para />
+        /// Note this deliberately does NOT go through DatDatabase.ReadFromDat: that cache is keyed
+        /// on file id alone and blind-casts to T, so caching a synthesized SetupModel under a mesh
+        /// id would make every later ReadFromDat&lt;GfxObj&gt; of that same id throw InvalidCastException
+        /// (and vice versa). Callers must cache these separately.
+        /// </summary>
+        public static SetupModel CreateSimpleSetup(uint gfxObjId, GfxObj gfxObj)
+        {
+            var setup = CreateSimpleSetup();
+
+            setup.Id = gfxObjId;
+            setup.Parts.Add(gfxObjId);
+
+            if (gfxObj != null && (gfxObj.Flags & GfxObjFlags.HasPhysics) != 0)
+            {
+                setup.Flags |= SetupFlags.HasPhysicsBSP;
+                setup.HasPhysicsBSP = true;
+            }
+
+            // a single resting frame covering the one part, matching the physics-side simple setup
+            setup.PlacementFrames.Add((int)Placement.Resting, new PlacementType());
+
+            return setup;
+        }
     }
 }
