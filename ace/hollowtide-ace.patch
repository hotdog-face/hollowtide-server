         }
diff --git a/Source/ACE.Server/Command/CommandManager.cs b/Source/ACE.Server/Command/CommandManager.cs
index e2340aee..e501c2de 100644
--- a/Source/ACE.Server/Command/CommandManager.cs
+++ b/Source/ACE.Server/Command/CommandManager.cs
@@ -128,17 +128,48 @@ public static void Initialize()
 
         private static void CommandThread()
         {
+            // ADDITIVE ACE MOD (headless server): when stdin is NOT a terminal (server backgrounded /
+            // daemonized), Console.ReadLine() returns null immediately on EOF, so the "ACE >> " prompt loop
+            // below busy-spins — pegging a CPU core and writing gigabytes of "ACE >> " to the log. Detect that
+            // and skip the interactive console entirely; the server runs headless (network + admin tooling).
+            // Interactive launches (a real Terminal tty) are unaffected. See server/ace-mods/.
+            // ACE_CONSOLE_STDIN=1 opts back IN to the console on redirected stdin. The content sandbox
+            // feeds stdin from a FIFO whose write end it holds open for the life of the server, so
+            // ReadLine() blocks between commands instead of returning null — no EOF, no busy-spin. That
+            // is what makes `accountcreate` reachable on a backgrounded sandbox (server/ace-sandbox/
+            // start-ace-sandbox.command `console` subcommand). The null-is-EOF break below makes this
+            // safe even if the writer does close.
+            var pipedConsole = Console.IsInputRedirected
+                            && Environment.GetEnvironmentVariable("ACE_CONSOLE_STDIN") == "1";
+            if (Console.IsInputRedirected && !pipedConsole)
+            {
+                Console.WriteLine("");
+                Console.WriteLine("ACEmulator running headless (stdin is not a terminal) — interactive console disabled.");
+                return;
+            }
+
             Console.WriteLine("");
-            Console.WriteLine("ACEmulator command prompt ready.");
+            Console.WriteLine(pipedConsole
+                ? "ACEmulator command console reading from redirected stdin (ACE_CONSOLE_STDIN=1)."
+                : "ACEmulator command prompt ready.");
             Console.WriteLine("");
             Console.WriteLine("Type \"acecommands\" for help.");
             Console.WriteLine("");
 
             for (; ; )
             {
-                Console.Write("ACE >> ");
+                // No "ACE >> " prompt on a piped console: nothing is there to read it, and it would
+                // bloat the log line-for-line with every command.
+                if (!pipedConsole)
+                    Console.Write("ACE >> ");
 
                 string commandLine = Console.ReadLine();
+                if (commandLine == null)
+                {
+                    // Real EOF (writer closed / stdin exhausted) — stop, never spin.
+                    Console.WriteLine("stdin closed — interactive console stopping.");
+                    return;
+                }
                 if (string.IsNullOrWhiteSpace(commandLine))
                     continue;
 
