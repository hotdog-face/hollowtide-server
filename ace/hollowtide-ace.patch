+        /// <summary>
+        /// (custom) TRUE if the client set the 0x80 flag on StartArea, requesting to skip the
+        /// Training Academy and begin in the starter town proper. Retail clients never set this.
+        /// Honored only when the allow_town_spawn shard property is enabled.
+        /// </summary>
+        public bool SkipAcademy { get; private set; }
+
+        /// <summary>
+        /// (custom) TRUE if the client set the 0x40 flag on StartArea, requesting the Samurai
+        /// starter loadout (Yoroi set + Kabuton) at creation. Composes with the 0x80 town-spawn
+        /// flag (0xC0 = both). Retail clients never set this. Honored only when the
+        /// samurai_starter_loadout shard property is enabled.
+        /// </summary>
+        public bool SamuraiLoadout { get; private set; }
+
         public bool IsAdmin { get; private set; }
         public bool IsSentinel { get; private set; }
 
@@ -63,6 +78,17 @@ public void Unpack(BinaryReader reader)
 
             StartArea = reader.ReadUInt32();
 
+            // (custom) high-bit flags on StartArea = create-time options from the custom client:
+            //   0x80 - player opted out of the Training Academy (allow_town_spawn)
+            //   0x40 - player picked the Samurai creation flavor (samurai_starter_loadout)
+            // The bits compose (0xC0 = both). Strip them here, unconditionally, BEFORE the value
+            // is used anywhere, so a flagged index can never reach the StarterAreas
+            // lookup/validation. Retail clients never set either bit, so their values pass
+            // through unchanged.
