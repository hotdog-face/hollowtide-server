+        /// <summary>
+        /// Dereth-Unity: overlay an object's own weenie_properties_anim_part rows onto the ObjDesc
+        /// its ClothingBase just built, so a weenie can name a gfxobj that exists in no .dat file.
+        ///
+        /// Only replaces a part the ClothingBase ALREADY changed. That one rule is what lets a
+        /// single row set do double duty. A helmet's ClothingTable touches part 16 on a creature
+        /// setup (head + helm, worn) and part 0 on item setup 0x020000DA (helm alone, dropped);
+        /// each override therefore lands on exactly the object that has that part, and neither
+        /// leaks onto the other. Without it, a part-0 override meant for the dropped model would
+        /// also repaint the wearer's abdomen.
+        ///
+        /// Replaces by INDEX. ObjDesc.AddAnimPartChange only drops an entry when the model id
+        /// matches as well, which would leave two models fighting over one part.
+        /// CopyTo null-checks its source, so an item with no rows costs one empty list.
+        /// </summary>
+        protected static void ApplyOwnAnimParts(ACE.Entity.ObjDesc objDesc, WorldObject wo, List<uint> coverage = null)
+        {
+            var extra = new List<PropertiesAnimPart>();
+            wo.Biota.PropertiesAnimPart.CopyTo(extra, wo.BiotaDatabaseLock);
+
+            foreach (var ap in extra)
+            {
+                var covered = false;
+                for (var i = objDesc.AnimPartChanges.Count - 1; i >= 0; i--)
+                {
+                    if (objDesc.AnimPartChanges[i].Index != ap.Index)
+                        continue;
+                    objDesc.AnimPartChanges.RemoveAt(i);
+                    covered = true;
+                }
+                if (!covered)
+                    continue;
+
+                objDesc.AnimPartChanges.Add(new PropertiesAnimPart { Index = ap.Index, AnimationId = ap.AnimationId });
+                if (coverage != null && !coverage.Contains(ap.Index))
+                    coverage.Add(ap.Index);
+            }
+        }
