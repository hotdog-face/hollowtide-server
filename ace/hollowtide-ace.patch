+        // agentuse <guid> — headless-agent helper: activate a world object directly
+        [CommandHandler("agentuse", AccessLevel.Admin, CommandHandlerFlag.RequiresWorld, 1,
+            "Activate a world object by guid directly, bypassing the move-to-object chain.",
+            "<0xGuid>\nFor headless agent/bot control: triggers portals/doors/NPCs without validated movement. " +
+            "Runs the object's real OnActivate (legit gates — portal cooldown/level/PK — still apply).")]
+        public static void HandleAgentUse(Session session, params string[] parameters)
+        {
+            var s = parameters[0];
+            if (s.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+                s = s.Substring(2);
