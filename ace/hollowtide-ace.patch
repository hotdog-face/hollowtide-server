+        }
+
+        // agentgive <targetGuid> <itemGuid> [amount] — headless-agent helper: hand an inventory item to an
+        // NPC/player directly, bypassing the move-to-target chain (headless bots run no client physics, so
+        // the chain never completes — the give hung silently). The NPC's REAL give/emote logic still runs.
+        [CommandHandler("agentgive", AccessLevel.Admin, CommandHandlerFlag.RequiresWorld, 2,
+            "Give an inventory item to a target by guid directly, bypassing the move-to-target chain.",
+            "<0xTargetGuid> <0xItemGuid> [amount]\nFor headless agent/bot control: quest handins etc. The target's real give/emote/refusal logic still applies.")]
+        public static void HandleAgentGive(Session session, params string[] parameters)
+        {
+            static bool ParseGuid(string s, out uint v)
+            {
+                if (s.StartsWith("0x", StringComparison.OrdinalIgnoreCase)) s = s.Substring(2);
+                return uint.TryParse(s, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out v);
+            }
+            if (!ParseGuid(parameters[0], out var targetGuid) || !ParseGuid(parameters[1], out var itemGuid))
+            {
+                ChatPacket.SendServerMessage(session, $"agentgive: invalid guid(s) '{parameters[0]}' '{parameters[1]}'", ChatMessageType.Broadcast);
+                return;
+            }
+            int amount = parameters.Length > 2 && int.TryParse(parameters[2], out var a) ? a : 1;
+            session.Player.AgentGiveDirect(targetGuid, itemGuid, amount);
+        }
+
         // time
         [CommandHandler("time", AccessLevel.Envoy, CommandHandlerFlag.None, 0,
             "Displays the server's current game time.")]
diff --git a/Source/ACE.Server/Entity/SetupResolver.cs b/Source/ACE.Server/Entity/SetupResolver.cs
new file mode 100644
index 00000000..565500a4
--- /dev/null
+++ b/Source/ACE.Server/Entity/SetupResolver.cs
@@ -0,0 +1,77 @@
+using System.Collections.Concurrent;
+
+using log4net;
+
+using ACE.DatLoader;
+using ACE.DatLoader.FileTypes;
+using ACE.Server.Managers;
+
+namespace ACE.Server.Entity
+{
+    /// <summary>
+    /// Resolves a weenie's Setup DID to a SetupModel, tolerating raw 0x01 GfxObj (mesh) ids.
+    /// <para />
+    /// Stock ACE assumes every Setup DID is a 0x02 SetupModel and reads it with
+    /// ReadFromDat&lt;SetupModel&gt;. Handing it a 0x01 mesh id makes SetupModel.Unpack read a garbage
+    /// numParts and run off the end of the buffer, throwing an uncaught EndOfStreamException on the
+    /// World Manager thread -- which aborts the whole process. This is not mesh-specific: all 15,318
+    /// 0x01 files in client_portal.dat fail to parse as a SetupModel.
+    /// <para />
+    /// The physics layer already handles 0x01 correctly (PhysicsObj.makeObject ->
+    /// InitPartArrayObject -> MasterDBMap.DivineType 0x01 -> PartArray.CreateMesh ->
+    /// Setup.MakeSimpleSetup), and the PhysicsPolygons / PhysicsBSP ride on the GfxObj, so collision
+    /// survives. Only the WorldObject-level read is broken. This routes 0x01 through the same
+    /// single-part wrapping the physics layer uses, and caches the result.
+    /// <para />
+    /// Why the synthesized setups get their own cache: DatDatabase.FileCache is keyed on file id
+    /// alone and blind-casts the hit to T. The mesh is also read as a GfxObj by the physics layer
+    /// (GfxObjCache -> DBObj.GetGfxObj -> ReadFromDat&lt;GfxObj&gt;), so reusing FileCache for the
+    /// synthesized SetupModel would make whichever read lost the race throw InvalidCastException on
+    /// the cast. Keeping them separate means neither type ever collides in FileCache.
+    /// </summary>
+    public static class SetupResolver
+    {
+        private static readonly ILog log = LogManager.GetLogger(System.Reflection.MethodBase.GetCurrentMethod().DeclaringType);
+
+        /// <summary>
+        /// Synthesized single-part setups for raw 0x01 mesh ids, kept out of DatDatabase.FileCache
+        /// so a mesh id never resolves to two different FileType subclasses in the same cache.
+        /// </summary>
+        private static readonly ConcurrentDictionary<uint, SetupModel> GfxObjSetups = new ConcurrentDictionary<uint, SetupModel>();
+
+        /// <summary>
+        /// An inert stand-in returned when a 0x01 setup is refused, so a bad weenie yields a
+        /// non-functional object instead of taking the server down. No parts, no physics BSP.
+        /// </summary>
+        private static readonly SetupModel InertSetup = SetupModel.CreateSimpleSetup();
+
+        private static readonly ConcurrentDictionary<uint, bool> LoggedRefusals = new ConcurrentDictionary<uint, bool>();
+
+        /// <summary>
+        /// True if this Setup DID points at a 0x01 GfxObj (a raw mesh) rather than a 0x02 SetupModel.
+        /// </summary>
+        public static bool IsGfxObjId(uint setupId) => (setupId >> 24) == 0x01;
+
+        /// <summary>
+        /// Reads the SetupModel for a Setup DID. 0x02 ids take the stock path unchanged; 0x01 ids are
+        /// wrapped (allow_gfxobj_setup enabled) or refused inertly (disabled).
+        /// </summary>
+        public static SetupModel GetSetup(uint setupId)
+        {
+            if (!IsGfxObjId(setupId))
+                return DatManager.PortalDat.ReadFromDat<SetupModel>(setupId);
+
+            if (!PropertyManager.GetBool("allow_gfxobj_setup").Item)
+            {
+                // Stock ACE would abort the process here. Refuse the object instead, once per id.
+                if (LoggedRefusals.TryAdd(setupId, true))
+                    log.Error($"SetupResolver.GetSetup(0x{setupId:X8}): Setup DID is a raw 0x01 GfxObj, not a 0x02 SetupModel. Refusing it (the object will be inert). Enable the allow_gfxobj_setup shard property to wrap raw meshes instead.");
+
+                return InertSetup;
+            }
+
+            return GfxObjSetups.GetOrAdd(setupId, id =>
+                SetupModel.CreateSimpleSetup(id, DatManager.PortalDat.ReadFromDat<GfxObj>(id)));
+        }
+    }
+}
diff --git a/Source/ACE.Server/Factories/ExtendedEyeColors.cs b/Source/ACE.Server/Factories/ExtendedEyeColors.cs
new file mode 100644
index 00000000..1f6932cc
--- /dev/null
+++ b/Source/ACE.Server/Factories/ExtendedEyeColors.cs
@@ -0,0 +1,146 @@
+using System.Collections.Generic;
+
+using ACE.DatLoader.Entity;
+using ACE.Server.Managers;
+
+namespace ACE.Server.Factories
+{
+    /// <summary>
+    /// (custom, extended_eye_colors shard prop) Full-spectrum eye colors — owner-requested deviation.
+    ///
+    /// The CharacterCreate wire carries an eye-color INDEX into the heritage×gender's dat EyeColorList;
+    /// what every client (including retail) RENDERS is the palette DID this index resolves to, baked into
+    /// the character's appearance (EyesPalette → the @0x20/0x8 ObjDesc subpalette). This class lets a
+    /// custom client send indices BEYOND the dat list length: the overflow maps into a curated table of
+    /// ADDITIONAL AUTHENTIC dat palettes below — full wire compatibility, retail clients render the new
+    /// colors natively, no client-side presentation hacks.
+    ///
+    /// ═══ EXTENDED-EYE-COLOR CONTRACT v2 (mirrored EXACTLY in the native client, Login/CharGenData.cs) ═══
+    ///   • wire EyeColor index i &lt; sex.EyeColorList.Count → stock: sex.EyeColorList[i] (retail path, unchanged).
+    ///   • i &gt;= Count → extended: k = i − Count indexes OFFERED(sex) = Table with the DIDs already present
+    ///     in sex.EyeColorList removed, TABLE ORDER PRESERVED (so the same table yields no duplicate chips
+    ///     and both sides derive the identical per-heritage sub-list from the same dat).
+    ///   • HeritageGroup 6 (Gearknight — the shard's A'nekshay slot) NEVER gets extended colors: its
+    ///     EyeColor wire field is the A'nekshay tint channel (client AnekshayRace encodes tint as
+    ///     EyeColor 0..5) — extended indices there would corrupt the tint decode.
+    ///   • prop OFF, or k out of range, or heritage excluded → resolve i % Count instead. NEVER reject:
+    ///     un-activated shards degrade gracefully (the create succeeds with a stock color).
+    ///   • The table order is FROZEN — append new entries at the END only (existing characters store the
+    ///     resolved DID, but share codes / client offerings depend on stable indices).
+    ///   • v2 (2026-07-15) REPLACED the v1 table wholesale — a clean break, nothing shipped to players.
+    ///     v1 shared every heritage's stock palette with everyone, but the eye subpalette zone 256..319
+    ///     is an interleaved per-index mix of iris and sclera/shading entries — the glow/Lugian/Undead/
+    ///     Gearknight palettes paint both, so on human faces the WHITES of the eyes went red/purple/etc
+    ///     (owner bug). v2 entries are all verified iris-safe on human faces (neutral + luma-matched on
+    ///     the sclera indices). The client's ChargenExtendedEyesCheck sclera-invariance suite enforces
+    ///     this; the client look-code version byte was bumped 1→2 in the same change.
+    /// </summary>
+    public static class ExtendedEyeColors
+    {
+        /// <summary>
+        /// The curated extended palette table (v2, 34 entries) — every DID is an AUTHENTIC portal.dat
+        /// palette (0x04, ≥320 entries) whose eye zone is IRIS-SAFE on human faces: near-neutral and
+        /// luma-matched to the human stock palettes on the sclera/shading indices, colored on the iris
+        /// indices only. [0..7] = the union of the four human heritages' stock EyeColorLists (the only
+        /// stock palettes safe by construction); [8..33] = curated picks from the full 0x04 dat scan,
+        /// chosen for hue coverage. Weighted iris colors (human eye-texel histogram) noted per line.
+        /// </summary>
+        public static readonly uint[] Table =
+        {
+            // ── the human stock union (8) — unchanged from v1 [0..7] ──
+            0x040002BC,   // steel blue        ( 55, 88,114)  human stock
+            0x040004B0,   // blue-violet       ( 51, 50,102)  human stock
+            0x040002BE,   // hazel             ( 86, 89, 50)  human stock
+            0x040002BF,   // olive             ( 48, 47, 24)  human stock
+            0x040002BD,   // green             ( 61, 90, 50)  human stock
+            0x040004AE,   // amber brown       ( 85, 62, 34)  human stock
+            0x040004AF,   // grey              ( 54, 54, 54)  human stock
+            0x040004B1,   // violet            ( 82, 49,100)  human stock
+            // ── curated iris-safe extras (26) ──
+            0x04001F59,   // onyx              ( 35, 35, 37)  black iris, bright whites
+            0x040019A3,   // charcoal          ( 51, 51, 51)
+            0x04000F63,   // light grey        ( 99, 99, 99)
+            0x04000F64,   // silver            (114,114,114)
+            0x04000EB6,   // crimson           (100, 55, 51)  the one true red iris in the dat
+            0x0400142C,   // gold              (109, 99, 41)
+            0x04001F3C,   // emerald           ( 55,108, 32)  vivid green
+            0x0400133E,   // jade              ( 51,100, 57)
+            0x04000403,   // mint              ( 58,106, 72)
+            0x04002040,   // deep teal         ( 37, 41, 41)
+            0x04002041,   // teal              ( 49, 53, 53)
+            0x04002042,   // aqua slate        ( 58, 63, 63)
+            0x04002039,   // midnight blue     ( 39, 39, 41)
+            0x04002047,   // indigo            ( 40, 40, 45)
+            0x04000459,   // navy              ( 40, 41, 79)
+            0x04000474,   // royal blue        ( 60, 60,121)
+            0x0400044E,   // bright blue       ( 65, 65,133)
+            0x04000450,   // sky blue          ( 93, 92,177)
+            0x04000988,   // sapphire          ( 37, 36, 94)
+            0x040005BD,   // deep sapphire     ( 40, 39, 95)
+            0x04001347,   // dark plum         ( 33, 28, 38)
+            0x0400204E,   // plum              ( 40, 36, 42)
+            0x0400204F,   // orchid            ( 55, 51, 57)
+            0x04000EB3,   // vivid violet      ( 83, 49,100)
+            0x04002050,   // lavender          ( 66, 61, 67)
+            0x04000EB9,   // rose              ( 94, 53, 82)
+        };
+
+        /// <summary>HeritageGroup ids whose EyeColor wire channel is repurposed — never extended.</summary>
+        public const uint ExcludedHeritageGearknight = 6;   // A'nekshay tint channel (see contract above)
+
+        /// <summary>
+        /// The extended DIDs OFFERED to a heritage×gender: the table minus the DIDs already in the sex's
+        /// stock EyeColorList, table order preserved. Deterministic from the dat — the client derives the
+        /// identical list. Empty for the Gearknight heritage (caller passes its heritage id).
+        /// </summary>
+        public static List<uint> OfferedFor(SexCG sex, uint heritage)
+        {
+            var offered = new List<uint>();
+            if (sex == null || heritage == ExcludedHeritageGearknight)
+                return offered;
+            foreach (var did in Table)
+                if (!sex.EyeColorList.Contains(did))
+                    offered.Add(did);
+            return offered;
+        }
+
+        /// <summary>
+        /// Resolve a CharacterCreate EyeColor index to the EyesPalette DID per the contract above.
+        /// In-range stock indices behave exactly as stock ACE; overflow maps into the extended table when
+        /// the extended_eye_colors prop is on, and degrades to (index % list length) otherwise — this
+        /// method never throws and never rejects (stock ACE would have thrown IndexOutOfRange here).
+        /// </summary>
+        public static uint Resolve(SexCG sex, uint heritage, uint eyeColorIndex)
+        {
+            if (sex == null || sex.EyeColorList.Count == 0)
+                return 0;
+
+            var count = sex.EyeColorList.Count;
+            if (eyeColorIndex < count)
+                return sex.EyeColorList[(int)eyeColorIndex];   // stock path, byte-for-byte retail behavior
+
+            if (PropertyManager.GetBool("extended_eye_colors").Item)
+            {
+                var offered = OfferedFor(sex, heritage);
+                var k = (int)(eyeColorIndex - count);
+                if (k < offered.Count)
+                    return offered[k];
+            }
+
+            // prop off / out of range / excluded heritage: clamp gracefully, never reject
+            return sex.EyeColorList[(int)(eyeColorIndex % count)];
+        }
+
+        /// <summary>
+        /// Barber (FinishBarber) legality: an extended-eyed character must be able to visit the barber
+        /// without the whole request being rejected. TRUE when the prop is on and the requested DID is one
+        /// of this heritage×gender's offered extended palettes (Gearknight stays stock-only — see contract).
+        /// </summary>
+        public static bool IsBarberLegal(uint requestedEyesPaletteDID, SexCG sex, uint heritage)
+        {
+            if (!PropertyManager.GetBool("extended_eye_colors").Item)
+                return false;
+            return OfferedFor(sex, heritage).Contains(requestedEyesPaletteDID);
+        }
+    }
+}
diff --git a/Source/ACE.Server/Factories/PlayerFactory.cs b/Source/ACE.Server/Factories/PlayerFactory.cs
